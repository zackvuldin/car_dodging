<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Car Dodger</title>
<style>
  body {
    margin: 0;
    overflow: hidden;
    background: #333;
    font-family: sans-serif;
    color: white;
    user-select: none;
  }
  canvas {
    display: block;
    background: #555;
    margin: 0 auto;
  }
  #score {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 24px;
    font-weight: bold;
  }
</style>
</head>
<body>
<div id="score">Score: 0</div>
<canvas id="gameCanvas" width="500" height="700"></canvas>
<script>
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const lanes = 5;
const laneWidth = canvas.width / lanes;

let player = {
    lane: 2,
    y: canvas.height - 100,
    width: laneWidth * 0.6,
    height: 80,
    color: "blue"
};

let cars = [];
let spawnTimer = 0;
let speed = 5;
let score = 0;

function drawPlayer() {
    ctx.fillStyle = player.color;
    ctx.fillRect(player.lane * laneWidth + laneWidth * 0.2, player.y, player.width, player.height);
}

function drawCars() {
    ctx.fillStyle = "red";
    cars.forEach(car => {
        ctx.fillRect(car.lane * laneWidth + laneWidth * 0.2, car.y, car.width, car.height);
    });
}

function drawLanes() {
    ctx.strokeStyle = "white";
    ctx.lineWidth = 2;
    for (let i = 1; i < lanes; i++) {
        ctx.beginPath();
        ctx.moveTo(i * laneWidth, 0);
        ctx.lineTo(i * laneWidth, canvas.height);
        ctx.stroke();
    }
}

function updateCars() {
    for (let i = cars.length - 1; i >= 0; i--) {
        cars[i].y += speed;
        if (cars[i].y > canvas.height) {
            cars.splice(i, 1);
            score++;
            document.getElementById("score").innerText = "Score: " + score;
        } else if (
            cars[i].lane === player.lane &&
            cars[i].y + cars[i].height > player.y &&
            cars[i].y < player.y + player.height
        ) {
            alert("Game Over! Score: " + score);
            document.location.reload();
        }
    }
}

function spawnCar() {
    if (spawnTimer <= 0) {
        cars.push({
            lane: Math.floor(Math.random() * lanes),
            y: -100,
            width: laneWidth * 0.6,
            height: 80
        });
        spawnTimer = 50 - Math.min(score, 30); // faster spawn as score increases
    } else {
        spawnTimer--;
    }
}

function gameLoop() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawLanes();
    drawPlayer();
    drawCars();
    updateCars();
    spawnCar();
    requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft" && player.lane > 0) player.lane--;
    if (e.key === "ArrowRight" && player.lane < lanes - 1) player.lane++;
});

gameLoop();
</script>
</body>
</html>
