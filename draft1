      const x = player.lane * laneWidth + (laneWidth - player.width) / 2;
      ctx.drawImage(playerImg, x, player.y, player.width, player.height);
    }

    function drawObstacles() {
      obstacles.forEach(o => {
        // Perspective effect: scale smaller when farther away
        const distanceFactor = 1 - (o.y / canvas.height) * 0.5;  
        const w = o.width * distanceFactor;
        const h = o.height * distanceFactor;
        const x = o.lane * laneWidth + (laneWidth - w) / 2;
        ctx.drawImage(obstacleImg, x, o.y, w, h);
