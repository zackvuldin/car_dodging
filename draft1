<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Car Dodger Preview</title>
<style>
  body { margin: 0; display: flex; flex-direction: column; align-items: center; background: #222; }
  button { margin: 20px; padding: 10px 20px; font-size: 18px; cursor: pointer; }
  iframe { border: 2px solid #fff; width: 600px; height: 800px; }
</style>
</head>
<body>

<button onclick="previewGame()">Preview Game</button>
<iframe id="gamePreview"></iframe>

<script>
const gameCode = `
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Car Dodger Game</title>
<style>
  body { margin: 0; overflow: hidden; background: #87CEEB; }
  canvas { display: block; margin: auto; background: #555; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<script>
// ----- Game Code Starts Here -----
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
canvas.width = 600;
canvas.height = 800;

const lanes = 5;
const laneWidth = canvas.width / lanes;

let player = { lane: 2, targetLane: 2, x: 0, width: 50, height: 100, color: 'blue' };
player.x = player.lane*laneWidth + laneWidth/2 - player.width/2;

let speed = 5;
let score = 0;
let gameOver = false;
let cars = [];
let powerUps = [];
let powerUpActive = false;
let powerUpTimer = 0;
let lastPowerUpTime = 0;

let sideObjects = [];
for(let i=0;i<20;i++){
  sideObjects.push({ x: Math.random()<0.5?10:canvas.width-60, y: i*100, type: Math.random()<0.5?'tree':'building', color:null });
}

let laneMarkerOffset = 0;

function drawRoad(){ ctx.fillStyle='#333'; ctx.fillRect(0,0,canvas.width,canvas.height); }

function drawLaneMarkers(){
  ctx.strokeStyle='white'; ctx.lineWidth=4; ctx.setLineDash([30,20]);
  for(let i=1;i<lanes;i++){ ctx.beginPath(); ctx.moveTo(i*laneWidth,-laneMarkerOffset); ctx.lineTo(i*laneWidth,canvas.height); ctx.stroke(); }
  ctx.setLineDash([]);
}

function drawSideVisuals(){
  for(let obj of sideObjects){
    obj.y+=speed;
    if(obj.y>canvas.height)obj.y=-100;
    if(obj.type==='tree'){
      ctx.fillStyle='darkgreen'; ctx.fillRect(obj.x+5,obj.y,10,30);
      ctx.fillStyle='green'; ctx.beginPath(); ctx.arc(obj.x+10,obj.y,15,0,Math.PI*2); ctx.fill();
    }else{
      if(!obj.color)obj.color=`rgb(${50+Math.random()*100},${50+Math.random()*100},${50+Math.random()*100})`;
      ctx.fillStyle=obj.color; ctx.fillRect(obj.x,obj.y,40,80);
      ctx.fillStyle='black'; ctx.fillRect(obj.x+5,obj.y+10,10,20); ctx.fillRect(obj.x+25,obj.y+10,10,20);
    }
  }
}

function drawCar(x,y,color){
  ctx.fillStyle=color; ctx.fillRect(x,y,50,100);
  ctx.fillStyle='black'; ctx.fillRect(x+5,y+70,10,10); ctx.fillRect(x+35,y+70,10,10);
}

function drawPlayer(){
  let targetX=player.targetLane*laneWidth+laneWidth/2-player.width/2;
  player.x += (targetX - player.x)*0.2;
  drawCar(player.x,canvas.height-player.height-20,player.color);
}

function spawnCar(){
  const lane=Math.floor(Math.random()*lanes);
  const colors=['red','green','black'];
  cars.push({lane:lane,y:-100,width:50,height:100,color:colors[Math.floor(Math.random()*colors.length)]});
}

function spawnPowerUp(){
  const lane=Math.floor(Math.random()*lanes);
  powerUps.push({lane:lane,y:-50,width:40,height:40,color:'yellow'});
}

function drawPowerUps(){
  for(let p of powerUps){
    ctx.fillStyle=p.color; ctx.beginPath();
    ctx.arc(p.lane*laneWidth + laneWidth/2, p.y+20, 20, 0, Math.PI*2); ctx.fill();
  }
}

function checkCollision(a,b){ return a.lane===b.lane && a.y+a.height>b.y && a.y<b.y+b.height; }

function update(){
  if(gameOver)return;
  laneMarkerOffset+=speed; if(laneMarkerOffset>50)laneMarkerOffset=0;

  for(let i=cars.length-1;i>=0;i--){
    cars[i].y+=speed;
    if(cars[i].y>canvas.height){ cars.splice(i,1); score+=powerUpActive?2:1; }
    else if(checkCollision({lane:player.targetLane,y:canvas.height-player.height-20,width:player.width,height:player.height},cars[i])) gameOver=true;
  }

  for(let i=powerUps.length-1;i>=0;i--){
    powerUps[i].y+=speed;
    if(powerUps[i].y>canvas.height) powerUps.splice(i,1);
    else if(checkCollision({lane:player.targetLane,y:canvas.height-player.height-20,width:player.width,height:player.height},powerUps[i])){
      powerUpActive=true; powerUpTimer=Date.now(); powerUps.splice(i,1);
    }
  }

  if(powerUpActive && Date.now()-powerUpTimer>5000) powerUpActive=false;
  speed+=0.001;

  if(Math.random()<0.1) spawnCar();
  if(Date.now()-lastPowerUpTime>15000){ spawnPowerUp(); lastPowerUpTime=Date.now(); }
}

function drawScore(){ ctx.fillStyle='white'; ctx.font='30px Arial'; ctx.fillText(`Score: ${score}`,canvas.width-160,40); }
function drawGameOver(){ ctx.fillStyle='rgba(0,0,0,0.7)'; ctx.fillRect(0,0,canvas.width,canvas.height); ctx.fillStyle='white'; ctx.font='50px Arial'; ctx.fillText('Game Over',canvas.width/2-130,canvas.height/2-20); ctx.fillText(`Score: ${score}`,canvas.width/2-100,canvas.height/2+50); }

function gameLoop(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  drawRoad(); drawSideVisuals(); drawLaneMarkers(); drawPlayer();
  for(let car of cars) drawCar(car.lane*laneWidth+laneWidth/2-25,car.y,car.color);
  drawPowerUps(); drawScore(); update();
  if(gameOver){ drawGameOver(); return; }
  requestAnimationFrame(gameLoop);
}

document.addEventListener('keydown',(e)=>{
  if(e.key==='ArrowLeft' && player.targetLane>0) player.targetLane--;
  if(e.key==='ArrowRight' && player.targetLane<lanes-1) player.targetLane++;
});

gameLoop();
// ----- Game Code Ends Here -----
</script>
</body>
</html>
`;

function previewGame(){
  const iframe = document.getElementById('gamePreview');
  iframe.srcdoc = gameCode;
}
</script>

</body>
</html>
